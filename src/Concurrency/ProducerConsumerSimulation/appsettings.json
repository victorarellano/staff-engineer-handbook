{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },  
  "ProducerConsumerSettings": {
    "ItemCount": 20,
    "ProducerDelayMilliseconds": 100,
    "ConsumerDelayMilliseconds": 1000,
    "EmptyQueuePollingDelayMilliseconds": 50,
    "ChannelCapacity": 5
  }
}
